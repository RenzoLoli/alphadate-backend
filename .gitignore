dist/
.aws-sam/

# Editors
.vscode/
.idea/
*.iml
.DS_Store

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*

# bun & bun-types
bun.lockb
**/*/bun.lockb
**/*/bun.lockb.lock
**/*/bun.lockb.log
**/.bun
**/.bun/cache
**/.bun/cache/bun.lockb
**/.bun/cache/bun.lockb.lock
**/.bun/cache/bun.lockb.log
**/.bun/default-env

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*
plan.tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sentitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# AI directories
.atl
